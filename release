#!/usr/bin/env bash
# Builds a release of the Jellyfin child server container, but only if everything passes first.
#
#   ./release                       # test, then build and tag jellyfin-child-server:<version>
#   ./release --tag my/image:1.2.3  # same, with your own tag (repeatable)
#   ./release --skip-e2e            # unit and integration tests only (no Docker suite)
#   ./release --push                # push the tags after a successful build
#
# Order matters: the .NET suites run first because they are the fastest way to find a break, then
# the browser suite in Docker against a real parent and child, and only then is the image built.
# Nothing is tagged unless every step above it passed. The image is built from the repository
# Dockerfile, whose runtime stage is Ubuntu (mcr.microsoft.com/dotnet/aspnet:10.0-resolute) with
# jellyfin-ffmpeg from repo.jellyfin.org; the build is checked for that ffmpeg before it is tagged.
#
# Needs: bash, dotnet 10, docker with the compose plugin, node (for the fixture library).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here"

IMAGE_NAME="jellyfin-child-server"
CONFIGURATION="Release"
run_e2e=1
do_push=0
tags=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tag)
      [[ $# -ge 2 ]] || { echo "release: --tag needs a value" >&2; exit 2; }
      tags+=("$2")
      shift 2
      ;;
    --skip-e2e)
      run_e2e=0
      shift
      ;;
    --push)
      do_push=1
      shift
      ;;
    -h | --help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "release: unknown argument '$1' (try --help)" >&2
      exit 2
      ;;
  esac
done

step() { printf '\n[release] %s\n' "$1"; }
fail() { printf '\n[release] FAILED: %s\n' "$1" >&2; exit 1; }

require() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required but was not found on PATH"
}

# ---------------------------------------------------------------------------
# What is being released
# ---------------------------------------------------------------------------

version="$(sed -n 's/.*AssemblyVersion("\(.*\)").*/\1/p' SharedVersion.cs | head -1)"
version="${version:-0.0.0}"
commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
dirty=""
if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
  dirty=" (working tree has uncommitted changes)"
fi

if [[ ${#tags[@]} -eq 0 ]]; then
  tags=("$IMAGE_NAME:$version" "$IMAGE_NAME:$commit" "$IMAGE_NAME:latest")
fi

step "releasing version $version from commit $commit$dirty"
printf '[release] tags: %s\n' "${tags[*]}"

require dotnet
if [[ $run_e2e -eq 1 ]]; then
  require docker
  require node
  docker compose version >/dev/null 2>&1 || fail "the docker compose plugin is required"
fi

# ---------------------------------------------------------------------------
# 1. The .NET suites
# ---------------------------------------------------------------------------

step "building the solution ($CONFIGURATION)"
dotnet build Jellyfin.sln --configuration "$CONFIGURATION" || fail "the solution does not build"

step "running the unit and integration tests"
dotnet test Jellyfin.sln --configuration "$CONFIGURATION" --no-build --verbosity minimal \
  || fail "unit or integration tests failed"

# The MCP server ships in the repository, so it is gated like everything else. It needs only node.
if command -v node >/dev/null 2>&1; then
  step "running the MCP server tests"
  (cd tools/jellyfin-mcp && npm ci --no-audit --no-fund && npm test) \
    || fail "the MCP server tests failed"
else
  step "skipping the MCP server tests (no node on PATH)"
fi

step "running the entrypoint environment tests"
bash tests/env/entrypoint.test.sh || fail "the entrypoint environment tests failed"

# ---------------------------------------------------------------------------
# 2. The browser suite, two servers in Docker
# ---------------------------------------------------------------------------

if [[ $run_e2e -eq 1 ]]; then
  step "running the end-to-end suite (parent, gate and child in Docker)"
  bash tests/e2e/run.sh || fail "the end-to-end suite failed (see tests/e2e/test-results)"
else
  step "skipping the end-to-end suite (--skip-e2e)"
fi

# ---------------------------------------------------------------------------
# 3. The image, with jellyfin-ffmpeg, only now
# ---------------------------------------------------------------------------

if ! command -v docker >/dev/null 2>&1; then
  fail "docker is required to build the image"
fi

step "building the container image"
build_args=(build --file Dockerfile)
for tag in "${tags[@]}"; do
  build_args+=(--tag "$tag")
done
build_args+=(--label "org.opencontainers.image.revision=$commit")
build_args+=(--label "org.opencontainers.image.version=$version")
build_args+=(.)
docker "${build_args[@]}" || fail "the image did not build"

# The point of the image is the patched ffmpeg, so prove it is the one that ended up in it. A
# distro ffmpeg would still run and still transcode; it just would not have Jellyfin's patches or
# the hardware acceleration, and nothing else in the suite would notice.
step "image built; checking it ships jellyfin-ffmpeg"
ffmpeg_banner=$(docker run --rm --entrypoint /usr/lib/jellyfin-ffmpeg/ffmpeg "${tags[0]}" -version 2>&1 | head -n 1) \
  || fail "jellyfin-ffmpeg is not at /usr/lib/jellyfin-ffmpeg/ffmpeg in the built image"
if grep -qi jellyfin <<<"$ffmpeg_banner"; then
  echo "[release] ffmpeg is the Jellyfin build: $ffmpeg_banner"
else
  fail "the ffmpeg in the image is not a Jellyfin build: $ffmpeg_banner"
fi

step "checking the server is pointed at jellyfin-ffmpeg"
configured_ffmpeg=$(docker run --rm --entrypoint sh "${tags[0]}" -c 'printf %s "$JELLYFIN_FFMPEG"')
if [[ "$configured_ffmpeg" == "/usr/lib/jellyfin-ffmpeg/ffmpeg" ]]; then
  echo "[release] JELLYFIN_FFMPEG=$configured_ffmpeg"
else
  fail "JELLYFIN_FFMPEG is '$configured_ffmpeg', not the jellyfin-ffmpeg build"
fi

if [[ $do_push -eq 1 ]]; then
  for tag in "${tags[@]}"; do
    step "pushing $tag"
    docker push "$tag" || fail "could not push $tag"
  done
fi

step "done"
printf '[release] %s\n' "${tags[@]}"
