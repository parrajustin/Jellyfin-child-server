# Jellyfin child server: runtime configuration.
#
#   docker run --env-file child-server.env ... xerofuzzion/jellyfin-child-server:latest-x86_64
#
# Setting CHILD_PARENT_URL makes the environment authoritative: <config>/childserver.xml is
# rewritten from these values on every boot, and edits made in the dashboard are replaced. Leave
# every CHILD_PARENT_* variable unset and the dashboard stays fully in charge.
#
# Every secret below also has a _FILE form, read from the named path, for Docker secrets and
# Kubernetes secret mounts. The _FILE form wins when both are set. Prefer it: an --env-file and a
# `docker inspect` both show plain values, a mounted file does not.

# ---------------------------------------------------------------------------
# The parent server
# ---------------------------------------------------------------------------

CHILD_PARENT_URL=https://jellyfin.example.com
CHILD_PARENT_USERNAME=remote

# One of these two, not both.
CHILD_PARENT_PASSWORD=
# CHILD_PARENT_PASSWORD_FILE=/run/secrets/child_parent_password

# ---------------------------------------------------------------------------
# A parent behind Cloudflare Access
# ---------------------------------------------------------------------------
#
# The service token must be covered by a Service Auth policy on the Access application. A valid
# token alone is not enough: without that policy Cloudflare answers 302 to its login page and the
# child reports AccessDenied. Cloudflare states this in the meta JWT of the redirect as
# "service_token_status": false.

# CF_ACCESS_CLIENT_ID=0123456789abcdef0123456789abcdef.access
# CF_ACCESS_CLIENT_SECRET=
# CF_ACCESS_CLIENT_ID_FILE=/run/secrets/cf_access_client_id
# CF_ACCESS_CLIENT_SECRET_FILE=/run/secrets/cf_access_client_secret

# Any other gateway headers, as "Name: value" pairs separated by semicolons or newlines. Only the
# first colon splits, so a value may contain colons.
# CHILD_PARENT_HEADERS=X-Gateway-Token: abc123; X-Tenant: home
# CHILD_PARENT_HEADERS_FILE=/run/secrets/child_parent_headers

# ---------------------------------------------------------------------------
# Cache and sync behaviour (optional; unset keeps the server's default)
# ---------------------------------------------------------------------------

# Upcoming episodes fetched while one is playing. Default 4.
# CHILD_PREFETCH_EPISODE_COUNT=4

# Cache ceiling in MB; 0 disables the limit. Default 5120. This is the number to set on a device
# with little disk, which is the whole point of the child server.
# CHILD_MAX_CACHE_SIZE_MB=5120

# How long a playback request waits for a download before giving up. Default 900.
# A transcode of a large uncached file waits for the whole download; direct play does not.
# CHILD_DOWNLOAD_WAIT_TIMEOUT_SECONDS=900

# Hours between library mirrors. Default 6.
# CHILD_SYNC_INTERVAL_HOURS=6

# Where the mirrored library lives. Defaults to a folder inside the data directory.
# CHILD_LIBRARY_PATH=/config/childserver/library

# ---------------------------------------------------------------------------
# Paths and hardware (already set in the image; override only if you must)
# ---------------------------------------------------------------------------

# JELLYFIN_DATA_DIR=/config
# JELLYFIN_CACHE_DIR=/cache
# JELLYFIN_CONFIG_DIR=/config/config
# JELLYFIN_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg

# For Intel QSV / VA-API or AMD, pass the device: --device /dev/dri:/dev/dri
# For NVIDIA, use --gpus all; NVIDIA_DRIVER_CAPABILITIES is already set in the image.
